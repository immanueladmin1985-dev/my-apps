{
  "rules": {
    "pins": {
      "$pin": {
        ".read": "auth != null",
        ".write": "auth != null && (!data.exists() || data.child('by').val() === auth.uid)",
        ".validate": "!newData.exists() || (newData.child('fid').isString() && newData.child('by').val() === auth.uid)"
      }
    },
    "families": {
      "$fid": {
        ".read": "auth != null && data.child('members/' + auth.uid).exists()",
        ".write": "auth != null && data.child('members/' + auth.uid).exists()",
        "members": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && (data.exists() || !data.parent().exists() || (root.child('pins/' + newData.child('pin').val() + '/fid').val() === $fid && root.child('pins/' + newData.child('pin').val() + '/at').val() > now - 900000))"
          }
        }
      }
    }
  }
}
