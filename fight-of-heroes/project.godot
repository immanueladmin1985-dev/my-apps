; Engine configuration file.
; 사람이 직접 고쳐도 된다. Godot 에디터에서 열면 형식이 정리될 수 있다.

config_version=5

[application]

config/name="Fight of Heroes"
config/description="오프라인 3대3 2D 모바일 AOS"
config/version="0.3.1"
run/main_scene="res://scenes/main/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.png"

[autoload]

EventBus="*res://scripts/core/event_bus.gd"
DataRegistry="*res://scripts/core/data_registry.gd"
SaveManager="*res://scripts/save/save_manager.gd"
GameManager="*res://scripts/core/game_manager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/mode=3
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4
window/energy_saving/keep_screen_on=true

[gui]

theme/custom_font="res://assets/fonts/NotoSansKR-SemiBold-subset.ttf"

[input_devices]

pointing/emulate_touch_from_mouse=true

[layer_names]

2d_physics/layer_1="world"
2d_physics/layer_2="units"

[physics]

common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.09, 0.11, 0.1, 1)
