[resource]
script = ExtResource("3")
id = "dragon_rage"
display_name = "용의 분노"
description = "공격하고 맞을수록 분노가 찹니다. 분노가 가득 차야 용으로 변신할 수 있고, 변신하면 Q·W·E 가 용의 스킬로 바뀝니다. 체력이 35% 아래면 방어력·마법 저항력 +30."
trigger = "periodic"
interval = 0.5
self_below_hp = 0.35
effects = Array[Resource]([SubResource("ApplyStatusEffect_1")])
